{
  "secret-guard.scan": {
    "type": "preToolCall",
    "description": "Asks before writing content that looks like a hardcoded secret",
    "matcher": "eca__write_file|eca__edit_file",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "file": "${plugin:root}/hooks/scan-secrets.sh"
      }
    ]
  }
}
