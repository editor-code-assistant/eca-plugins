{
  "context-mode.chat-start": {
    "type": "chatStart",
    "visible": false,
    "description": "Inject context-mode resume guidance at chat start.",
    "actions": [
      { "type": "shell", "file": "${plugin:root}/hooks/ctx-hook.sh" }
    ]
  },
  "context-mode.pre-request": {
    "type": "preRequest",
    "visible": false,
    "description": "Capture the user prompt and deliver context-mode recall.",
    "actions": [
      { "type": "shell", "file": "${plugin:root}/hooks/ctx-hook.sh" }
    ]
  },
  "context-mode.pre-tool": {
    "type": "preToolCall",
    "matcher": {
      "eca__shell_command": {},
      "eca__read_file": {},
      "eca__grep": {}
    },
    "visible": false,
    "description": "Deny context-flooding fetches and large unbounded reads.",
    "actions": [
      { "type": "shell", "file": "${plugin:root}/hooks/ctx-hook.sh" }
    ]
  },
  "context-mode.post-tool": {
    "type": "postToolCall",
    "matcher": {
      "eca__shell_command": {},
      "eca__read_file": {},
      "eca__write_file": {},
      "eca__edit_file": {},
      "eca__move_file": {},
      "eca__grep": {},
      "eca__directory_tree": {},
      "eca__git": {},
      "eca__ask_user": {}
    },
    "runOnError": true,
    "visible": false,
    "description": "Trim large results and journal session events.",
    "actions": [
      { "type": "shell", "file": "${plugin:root}/hooks/ctx-hook.sh" }
    ]
  },
  "context-mode.pre-compact": {
    "type": "preCompact",
    "visible": false,
    "description": "Persist a context-mode resume snapshot before compaction.",
    "actions": [
      { "type": "shell", "file": "${plugin:root}/hooks/ctx-hook.sh" }
    ]
  },
  "context-mode.post-compact": {
    "type": "postCompact",
    "visible": false,
    "description": "Inject the context-mode resume snapshot after compaction.",
    "actions": [
      { "type": "shell", "file": "${plugin:root}/hooks/ctx-hook.sh" }
    ]
  }
}
