{
  "session-journal.start": {
    "type": "chatStart",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "file": "${plugin:root}/hooks/journal-start.sh"
      }
    ]
  },
  "session-journal.end": {
    "type": "chatEnd",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "file": "${plugin:root}/hooks/journal-end.sh"
      }
    ]
  }
}
