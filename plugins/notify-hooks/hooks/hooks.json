{
  "notify-hooks.finished": {
    "type": "postRequest",
    "description": "Plays a sound when ECA finishes responding",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "shell": "cat > /dev/null; canberra-gtk-play -i complete 2>/dev/null || afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true"
      }
    ]
  },
  "notify-hooks.approval": {
    "type": "preToolCall",
    "description": "Plays a sound when ECA needs your approval or asks you a question",
    "visible": false,
    "actions": [
      {
        "type": "shell",
        "shell": "jq -e '.approval == \"ask\"' > /dev/null && (canberra-gtk-play -i message 2>/dev/null || afplay /System/Library/Sounds/Ping.aiff 2>/dev/null || true)"
      }
    ]
  }
}
